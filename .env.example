# ──────────────────────────────────────────────────────────────
# CamMonitor environment — copy to `.env` (cp .env.example .env)
# docker-compose.yml and the backend container read this file via `env_file`.
# ──────────────────────────────────────────────────────────────

# Port the NestJS backend listens on (UI + REST API + HLS proxy)
PORT=3000

# PostgreSQL connection (DB_HOST is the compose service name `postgres`)
DB_HOST=postgres
DB_PORT=5432
DB_USER=camadmin
DB_PASS=camplexpass
DB_NAME=camerasdb

# JWT signing — CHANGE THE SECRET before exposing this anywhere real
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=12h

# MediaMTX Control API (used by the backend to add/remove camera paths)
MEDIAMTX_API_URL=http://mediamtx:9997
MEDIAMTX_API_USER=admin
MEDIAMTX_API_PASSWORD=admin123

# Where FFmpeg demo publishers push RTSP to (compose service name)
MEDIAMTX_RTSP_URL=rtsp://mediamtx:8554

# Internal HLS origin that the backend proxies at /api/hls/** (ngrok-safe)
MEDIAMTX_HLS_INTERNAL=http://mediamtx:8888

# Directory with demo .mp4 files (mounted from ./videos in compose)
VIDEOS_DIR=/videos

# Demo publisher mode:
#   external  = separate demo-publisher container opens OUTBOUND RTSP
#               connections to MediaMTX and pushes (real push demo — default)
#   inprocess = legacy: the backend spawns FFmpeg child processes itself
DEMO_PUBLISHER=external

# Shared key the standalone demo publisher uses to fetch its work list
# from GET /api/internal/demo-cameras (not a user login — machine-to-machine)
PUBLISHER_KEY=dev-publisher-key
